#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Push constants must match vv::render::PushConstants in
// src/render/SceneData.hpp.
layout(push_constant) uniform Push {
    uvec4 screen;   // x=width, y=height, z=bgra, w=frame
    vec4 camera;    // x=tanHalfFov, y=fogDensity
    uvec4 chunkSize; // x=chunkX, y=worldHeight, z=chunkZ, w=maxTraceSteps
    vec4 voxelSize; // xyz=voxel size in world units
    ivec4 region;   // x,z = region origin (min corner) in chunk coords
    uvec4 grid;     // x=gridWidth, y=gridHeight, z=slot stride (u32 words)
} pc;

// Voxel atlas: all loaded chunks; each slot holds one chunk's voxel types
// (one byte per type) packed 4-per-uint32 in X + Y*chunkX + Z*chunkX*H order.
layout(set = 0, binding = 0) readonly buffer Voxels {
    uint data[];
} voxels;

layout(set = 0, binding = 1) writeonly buffer OutPixels {
    uint outData[];
} outPixels;

layout(std140, set = 0, binding = 2) uniform Scene {
    vec4 camPos;
    vec4 camForward;
    vec4 camRight;
    vec4 camUp;
    vec4 lightDir;
    vec4 lightColor;
    vec4 skyLow;
    vec4 skyHigh;
    vec4 misc; // x = timeSeconds
} scene;

// Chunk table: one u32 atlas slot index per region grid cell
// (row-major over gridWidth x gridHeight, relative to pc.region origin).
layout(set = 0, binding = 3) readonly buffer ChunkTable {
    uint slots[];
} chunkTable;

const uint kEmptySlot = 0xFFFFFFFFu;

// Voxel type palette. KEEP IN SYNC with kVoxelTypeInfo in
// src/voxel/VoxelTypes.hpp (order: Air, Grass, Dirt, Stone, Sand, Snow,
// Bedrock).
const int kTypeCount = 7;
const vec3 kTopColor[kTypeCount] = vec3[kTypeCount](
    vec3(0.00, 0.00, 0.00),
    vec3(0.26, 0.55, 0.14),
    vec3(0.43, 0.31, 0.18),
    vec3(0.56, 0.56, 0.58),
    vec3(0.87, 0.81, 0.60),
    vec3(0.93, 0.95, 0.98),
    vec3(0.18, 0.17, 0.19)
);
const vec3 kSideColor[kTypeCount] = vec3[kTypeCount](
    vec3(0.00, 0.00, 0.00),
    vec3(0.40, 0.31, 0.15),
    vec3(0.40, 0.29, 0.17),
    vec3(0.52, 0.52, 0.55),
    vec3(0.83, 0.77, 0.57),
    vec3(0.88, 0.90, 0.95),
    vec3(0.18, 0.17, 0.19)
);
const vec3 kBottomColor[kTypeCount] = vec3[kTypeCount](
    vec3(0.00, 0.00, 0.00),
    vec3(0.43, 0.31, 0.18),
    vec3(0.36, 0.25, 0.15),
    vec3(0.47, 0.47, 0.50),
    vec3(0.79, 0.73, 0.54),
    vec3(0.84, 0.86, 0.92),
    vec3(0.18, 0.17, 0.19)
);

// Division rounding towards negative infinity (GLSL '/' truncates).
int floorDiv(int a, int b)
{
    int q = a / b;
    if ((a % b != 0) && ((a < 0) != (b < 0))) {
        --q;
    }
    return q;
}

// Voxel type at a global (possibly negative) voxel coordinate. Returns 0
// (air) for anything outside the loaded region or in an empty slot.
uint voxelTypeAt(ivec3 cell)
{
    const int chunkX = int(pc.chunkSize.x);
    const int chunkZ = int(pc.chunkSize.z);

    const ivec2 cc = ivec2(floorDiv(cell.x, chunkX), floorDiv(cell.z, chunkZ));
    const ivec2 gridLocal = cc - pc.region.xz;
    if (any(lessThan(gridLocal, ivec2(0))) ||
        any(greaterThanEqual(gridLocal, ivec2(pc.grid.xy)))) {
        return 0u;
    }

    const uint slot =
        chunkTable.slots[uint(gridLocal.x) + uint(gridLocal.y) * pc.grid.x];
    if (slot == kEmptySlot) {
        return 0u;
    }

    const ivec3 local = ivec3(cell.x - cc.x * chunkX, cell.y,
                              cell.z - cc.y * chunkZ);
    const uint idx = uint(local.x) + uint(local.y) * pc.chunkSize.x +
                     uint(local.z) * (pc.chunkSize.x * pc.chunkSize.y);

    const uint word = voxels.data[slot * pc.grid.z + (idx >> 2u)];
    return (word >> ((idx & 3u) * 8u)) & 0xFFu;
}

bool intersectAABB(vec3 ro, vec3 rd, vec3 bmin, vec3 bmax, out float tmin, out float tmax, out vec3 enterNormal)
{
    vec3 inv = 1.0 / rd;
    vec3 t0 = (bmin - ro) * inv;
    vec3 t1 = (bmax - ro) * inv;
    vec3 tsmaller = min(t0, t1);
    vec3 tbigger = max(t0, t1);

    tmin = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    tmax = min(min(tbigger.x, tbigger.y), tbigger.z);

    // Determine which face we enter through (axis of tmin).
    // Normal points outward from the box.
    enterNormal = vec3(0.0);
    if (tsmaller.x >= tsmaller.y && tsmaller.x >= tsmaller.z) {
        enterNormal = (t0.x < t1.x) ? vec3(-1.0, 0.0, 0.0) : vec3(1.0, 0.0, 0.0);
    } else if (tsmaller.y >= tsmaller.z) {
        enterNormal = (t0.y < t1.y) ? vec3(0.0, -1.0, 0.0) : vec3(0.0, 1.0, 0.0);
    } else {
        enterNormal = (t0.z < t1.z) ? vec3(0.0, 0.0, -1.0) : vec3(0.0, 0.0, 1.0);
    }
    return tmax >= max(tmin, 0.0);
}

uint packColor(vec3 rgb01)
{
    vec3 c = clamp(rgb01, 0.0, 1.0);
    uint r = uint(c.r * 255.0 + 0.5);
    uint g = uint(c.g * 255.0 + 0.5);
    uint b = uint(c.b * 255.0 + 0.5);
    uint a = 255u;

    if (pc.screen.z != 0u) {
        return (a << 24) | (r << 16) | (g << 8) | (b << 0);
    }
    return (a << 24) | (b << 16) | (g << 8) | (r << 0);
}

vec3 skyColor(vec3 rd)
{
    float t = clamp(rd.y * 0.5 + 0.5, 0.0, 1.0);
    return mix(scene.skyLow.xyz, scene.skyHigh.xyz, t);
}

vec3 voxelColor(uint type, vec3 normal)
{
    if (normal.y > 0.5) {
        return kTopColor[type];
    }
    if (normal.y < -0.5) {
        return kBottomColor[type];
    }
    return kSideColor[type];
}

void main()
{
    uvec2 p = gl_GlobalInvocationID.xy;
    uvec2 size = pc.screen.xy;
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }

    uint idx = p.y * size.x + p.x;

    // Aspect handling: vertical FOV; the horizontal axis is scaled by the
    // aspect ratio.
    vec2 uv = (vec2(p) + vec2(0.5)) / vec2(size);
    uv = uv * 2.0 - 1.0;
    uv.y = -uv.y;
    float aspect = float(size.x) / float(size.y);
    uv.x *= aspect;

    vec3 camPos = scene.camPos.xyz;
    vec3 forward = normalize(scene.camForward.xyz);
    vec3 right = normalize(scene.camRight.xyz);
    vec3 up = normalize(scene.camUp.xyz);

    float tanHalfFov = pc.camera.x;
    vec3 rdWorld = normalize(forward + right * (uv.x * tanHalfFov) + up * (uv.y * tanHalfFov));
    vec3 roWorld = camPos;

    vec3 voxelSize = max(pc.voxelSize.xyz, vec3(1e-6));
    vec3 ro = roWorld / voxelSize;
    vec3 rd = rdWorld / voxelSize;

    // Region (loaded world) bounds in global voxel space.
    ivec3 regionMinVox = ivec3(pc.region.x * int(pc.chunkSize.x), 0,
                               pc.region.z * int(pc.chunkSize.z));
    ivec3 regionMaxVox = regionMinVox + ivec3(
        int(pc.grid.x) * int(pc.chunkSize.x),
        int(pc.chunkSize.y),
        int(pc.grid.y) * int(pc.chunkSize.z));

    vec3 bmin = vec3(regionMinVox);
    vec3 bmax = vec3(regionMaxVox);
    float tEnter = 0.0;
    float tExit = 0.0;
    vec3 enterNormal = vec3(0.0);
    if (!intersectAABB(ro, rd, bmin, bmax, tEnter, tExit, enterNormal)) {
        outPixels.outData[idx] = packColor(skyColor(rdWorld));
        return;
    }

    vec3 start = ro + rd * max(tEnter, 0.0);
    start = min(start, bmax - vec3(1e-4));
    start += rd * 1e-4;

    ivec3 cell = ivec3(floor(start));
    float tEnd = tExit - max(tEnter, 0.0);

    const float EPS = 1e-6;

    int stepX = (rd.x > 0.0) ? 1 : -1;
    int stepY = (rd.y > 0.0) ? 1 : -1;
    int stepZ = (rd.z > 0.0) ? 1 : -1;

    float tMaxX = 1e30;
    float tMaxY = 1e30;
    float tMaxZ = 1e30;
    float tDeltaX = 1e30;
    float tDeltaY = 1e30;
    float tDeltaZ = 1e30;

    if (abs(rd.x) > EPS) {
        float nextX = float(cell.x + ((stepX > 0) ? 1 : 0));
        tMaxX = (nextX - start.x) / rd.x;
        tDeltaX = abs(1.0 / rd.x);
    } else {
        stepX = 0;
    }

    if (abs(rd.y) > EPS) {
        float nextY = float(cell.y + ((stepY > 0) ? 1 : 0));
        tMaxY = (nextY - start.y) / rd.y;
        tDeltaY = abs(1.0 / rd.y);
    } else {
        stepY = 0;
    }

    if (abs(rd.z) > EPS) {
        float nextZ = float(cell.z + ((stepZ > 0) ? 1 : 0));
        tMaxZ = (nextZ - start.z) / rd.z;
        tDeltaZ = abs(1.0 / rd.z);
    } else {
        stepZ = 0;
    }

    bool hit = false;
    vec3 normal = vec3(0.0);
    uint hitType = 0u;
    // Ray parameter (world units: rdWorld is normalized) at the entry of the
    // current cell, relative to the region entry point; the distance from the
    // camera is tEntryOffset + t.
    float t = 0.0;
    const float tEntryOffset = max(tEnter, 0.0);

    int lastAxis = -1;
    for (int i = 0; i < int(pc.chunkSize.w); ++i) {
        uint type = voxelTypeAt(cell);
        if (type != 0u) {
            hit = true;
            hitType = type;
            if (lastAxis == 0) {
                normal = vec3(-float(stepX), 0.0, 0.0);
            } else if (lastAxis == 1) {
                normal = vec3(0.0, -float(stepY), 0.0);
            } else if (lastAxis == 2) {
                normal = vec3(0.0, 0.0, -float(stepZ));
            } else {
                normal = enterNormal;
            }
            break;
        }

        float nextT = 0.0;
        if (tMaxX < tMaxY && tMaxX < tMaxZ) {
            nextT = tMaxX;
            tMaxX += tDeltaX;
            cell.x += stepX;
            lastAxis = 0;
        } else if (tMaxY < tMaxZ) {
            nextT = tMaxY;
            tMaxY += tDeltaY;
            cell.y += stepY;
            lastAxis = 1;
        } else {
            nextT = tMaxZ;
            tMaxZ += tDeltaZ;
            cell.z += stepZ;
            lastAxis = 2;
        }

        if (nextT > tEnd) {
            break;
        }
        t = nextT;
    }

    vec3 color = vec3(0.0);
    if (hit) {
        vec3 lightDir = normalize(scene.lightDir.xyz);
        float ndl = max(dot(normalize(normal), lightDir), 0.0);
        vec3 base = voxelColor(hitType, normal);
        vec3 lit = base * (0.15 + 0.85 * ndl);
        color = lit * scene.lightColor.xyz;

        // Distance fog towards the sky in this direction; hides the region
        // edge and gives the world aerial perspective.
        float dist = tEntryOffset + t;
        float fog = 1.0 - exp(-dist * pc.camera.y);
        color = mix(color, skyColor(rdWorld), clamp(fog, 0.0, 1.0));
    } else {
        color = skyColor(rdWorld);
    }

    outPixels.outData[idx] = packColor(color);
}
