        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/src/**",
                "/usr/include/**",
                "/usr/include/x86_64-linux-gnu/**",
                "${QT_INCLUDE_DIR}/**"
            ],
            "defines": [
                "VV_HAVE_XCB=1",
                "VV_HAVE_WAYLAND=1"
            ],
            "intelliSenseMode": "linux-gcc-x64",
            "compilerPath": "/usr/bin/g++",
            "cStandard": "c23",
            "cppStandard": "c++23"
        }
