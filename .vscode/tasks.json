{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-configure-debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/debug",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Debug"
            ],
            "linux": {
                "args": [
                    "-S",
                    "${workspaceFolder}",
                    "-B",
                    "${workspaceFolder}/build/debug",
                    "-DCMAKE_BUILD_TYPE=Debug"
                ]
            },
            "osx": {
                "args": [
                    "-S",
                    "${workspaceFolder}",
                    "-B",
                    "${workspaceFolder}/build/debug",
                    "-DCMAKE_BUILD_TYPE=Debug"
                ]
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "cmake-configure-release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/release",
                "-G",
                "MinGW Makefiles",
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "linux": {
                "args": [
                    "-S",
                    "${workspaceFolder}",
                    "-B",
                    "${workspaceFolder}/build/release",
                    "-DCMAKE_BUILD_TYPE=Release"
                ]
            },
            "osx": {
                "args": [
                    "-S",
                    "${workspaceFolder}",
                    "-B",
                    "${workspaceFolder}/build/release",
                    "-DCMAKE_BUILD_TYPE=Release"
                ]
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "cmake-build-debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/debug",
                "--parallel ${env:NUMBER_OF_PROCESSORS}",
                "--config",
                "Debug"
            ],
            "linux": {
                "args": [
                    "--build",
                    "${workspaceFolder}/build/debug",
                    "--parallel"
                ]
            },
            "osx": {
                "args": [
                    "--build",
                    "${workspaceFolder}/build/debug",
                    "--parallel"
                ]
            },
            "dependsOn": "cmake-configure-debug",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "cmake-build-release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/release",
                "--parallel ${env:NUMBER_OF_PROCESSORS}",
                "--config",
                "Release"
            ],
            "linux": {
                "args": [
                    "--build",
                    "${workspaceFolder}/build/release",
                    "--parallel"
                ]
            },
            "osx": {
                "args": [
                    "--build",
                    "${workspaceFolder}/build/release",
                    "--parallel"
                ]
            },
            "dependsOn": "cmake-configure-release",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "cmake-package-debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/debug",
                "--target",
                "package_folder"
            ],
            "dependsOn": "cmake-build-debug",
            "group": "build",
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "cmake-package-release",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/release",
                "--target",
                "package_folder"
            ],
            "dependsOn": "cmake-build-release",
            "group": "build",
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.*?):(\\d+):(\\d+):\\s+(?:fatal\\s+)?(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        }
    ]
}
