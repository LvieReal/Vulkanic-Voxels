#pragma once

// Generated by CMake from src/core/Version.h.in. Do not edit by hand; the
// value is baked in at configure time from the current git state so bug
// reports can name the exact build they ran.
namespace vv::core {

// Short git commit hash, suffixed with "-dirty" when the working tree had
// local modifications at configure time ("unknown" outside a git checkout).
inline constexpr const char* kBuildId = "@VV_BUILD_ID@";

}  // namespace vv::core
